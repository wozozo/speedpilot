{
  "name": "speedpilot",
  "version": "1.0.0",
  "description": "Video Speed Control Chrome Extension",
  "private": true,
  "scripts": {
    "build": "tsc && node -e \"const fs = require('node:fs'); const file = 'dist/content.js'; const js = fs.readFileSync(file, 'utf8').replace(/\\nexport \\{ VideoController \\};\\n/, '\\n'); fs.writeFileSync(file, js);\"",
    "watch": "tsc -w",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "check": "oxlint . && oxfmt --check src",
    "package": "./scripts/build-extension.sh",
    "format2": "oxfmt src && oxlint . && oxfmt --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.254",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^18.0.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
