{
  "name": "speedpilot",
  "version": "1.0.0",
  "description": "Video Speed Control Chrome Extension",
  "private": true,
  "scripts": {
    "build": "tsc && sed -i '' '/export.*VideoController/d' dist/content.js",
    "watch": "tsc -w",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "package": "./scripts/build-extension.sh",
    "format2": "npm run format && npm run lint && npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.254",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^18.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
