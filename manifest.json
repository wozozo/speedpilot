{
  "manifest_version": 3,
  "name": "SpeedPilot",
  "version": "1.0.0",
  "description": "Control YouTube and other video playback with keyboard shortcuts",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.youtube.com/*", "https://youtube.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html"
}
